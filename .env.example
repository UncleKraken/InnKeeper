# Copy to .env and fill in. Never commit .env.

# Development: 1. Production: 0.
DJANGO_DEBUG=0
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
# Hostnames/IPs staff use to reach InnKeeper, comma separated
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,innkeeper.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://innkeeper.example.com
# Set both to 0 only if you are NOT serving over HTTPS (e.g. a closed office LAN)
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_SECURE_COOKIES=1

# Leave empty for SQLite. For PostgreSQL:
# DATABASE_URL=postgres://innkeeper:password@db:5432/innkeeper
DATABASE_URL=

INNKEEPER_DEFAULT_LANGUAGE=sq
INNKEEPER_TIME_ZONE=Europe/Tirane
INNKEEPER_SESSION_HOURS=12
